{
  "name": "livingroot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc -p tsconfig.api.json",
    "dev:api": "tsx scripts/dev-api.ts",
    "dev:mock": "LR_DEV_MOCK=1 LR_DEV_OUTBOX=.dev-outbox tsx scripts/dev-api.ts",
    "demo": "concurrently -k -n api,web \"npm:dev:mock\" \"VITE_LR_DEMO=1 vite --port=3000\""
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@supabase/supabase-js": "^2.45.0",
    "firebase": "^10.0.0",
    "firebase-admin": "^12.7.0",
    "lucide-react": "^0.383.0",
    "motion": "^12.23.24",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.7",
    "resend": "^3.5.0",
    "twilio": "^5.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^3.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.5",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.15",
    "typescript": "~5.5.3",
    "vite": "^5.4.1"
  }
}
