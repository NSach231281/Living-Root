# ─── COPY THIS FILE TO .env.local AND FILL IN YOUR VALUES ───────────────────
# .env.local is gitignored — never commit your actual keys

# Firebase (from your Firebase console → Project Settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=living-root.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://living-root-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=living-root
VITE_FIREBASE_STORAGE_BUCKET=living-root.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1036433941276
VITE_FIREBASE_APP_ID=1:1036433941276:web:180fcd19c61230385490d9

# Gemini AI (from ai.studio → Get API Key)
# ↓ THIS IS WHERE YOUR GEMINI KEY GOES ↓
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Payment — Yes Bank UPI ID for event bookings
VITE_UPI_ID=yourupiid@yesbank
VITE_UPI_NAME=Living Root Space

# App
VITE_APP_URL=https://livingrootspace.com

# ─── Bookings module (server-side, set on Vercel — see BOOKINGS_SETUP.md) ───────
APP_URL=https://livingrootspace.com
FIREBASE_SERVICE_ACCOUNT=            # whole service-account JSON (required)
GMAIL_USER=livingrootspace@gmail.com # email sender (required)
GMAIL_APP_PASSWORD=                  # 16-letter Google app password (required)
STAFF_EMAILS=livingrootspace@gmail.com # team emails for alerts (comma-separated)
CRON_SECRET=                         # any long random string
CALENDAR_FEED_KEY=                   # any long random string (calendar feed password)
TELEGRAM_BOT_TOKEN=                  # optional: team alerts
TELEGRAM_CHAT_ID=                    # optional
NOTION_TOKEN=                        # optional: mirror bookings into a Notion database
NOTION_DATABASE_ID=                  # optional
WHATSAPP_TOKEN=                      # optional: WhatsApp Cloud API (BOOKINGS_SETUP.md step 8)
WHATSAPP_PHONE_NUMBER_ID=
STAFF_WHATSAPP=                      # optional: team numbers for alerts
